# labextend env reference. Copy to .env and edit for local dev.
# README.md has the full table with defaults and roles.
# In production, prefer docker secrets over env vars for the BPM_* keys.

# ─── role selector ──────────────────────────────────────────────────────────
# Set LEADER=true on the leader node. Otherwise set LEADER_ADDR to point an
# agent at the leader's gRPC endpoint. Exactly one of the two must be set.
LEADER=true
# LEADER_ADDR=labextend-leader:9090

# ─── network ────────────────────────────────────────────────────────────────
HTTP_ADDR=:8080
GRPC_ADDR=:9090
EXTERNAL_URL=http://localhost:8080

# ─── storage ────────────────────────────────────────────────────────────────
DATA_DIR=/data

# ─── shared secret used by both leader and agents on the gRPC channel ───────
# Generate: openssl rand -hex 32
BPM_AGENT_TOKEN=

# ─── optional mTLS, cert-based auth on top of the token (scripts/gen-mtls.sh) ─
# BPM_GRPC_TLS_CERT=/run/secrets/grpc.crt
# BPM_GRPC_TLS_KEY=/run/secrets/grpc.key
# BPM_GRPC_TLS_CLIENT_CA=/run/secrets/ca.crt

# ─── leader-only at-rest encryption key ─────────────────────────────────────
# 32 bytes of hex (64 chars), AES-GCM key for stored S3 credentials.
# Generate: openssl rand -hex 32. Leader auto-generates both secrets into
# DATA_DIR/.env.generated when empty; losing this key loses the S3 creds.
BPM_SECRETS_KEY=

# ─── sessions ───────────────────────────────────────────────────────────────
# Default name is __Host-bpm_session with secure cookies, bpm_session without.
# SESSION_COOKIE_NAME=
SESSION_TTL_HOURS=12
# Sign out after this many hours without a request; 0 disables it.
SESSION_IDLE_HOURS=2
SESSION_SECURE_COOKIE=true

# ─── OIDC login (required, e.g. Pocket ID) ──────────────────────────────────
# The only way to sign in. Works only when issuer, client id and client secret
# are all set. The redirect URL to register at the provider is
# EXTERNAL_URL + /api/auth/oidc/callback; request scopes openid profile email groups.
BPM_OIDC_ISSUER=https://id.bartis.dev
BPM_OIDC_CLIENT_ID=
BPM_OIDC_CLIENT_SECRET=
# BPM_OIDC_CLIENT_SECRET_FILE=/run/secrets/labextend_oidc_client_secret
# BPM_OIDC_NAME=Pocket ID
#
# Provider group names: members of the user group may sign in, members of the
# admin group sign in as admin. Everyone else is refused.
# BPM_OIDC_USER_GROUP=labextend
# BPM_OIDC_ADMIN_GROUP=labextend-admins

# ─── reverse proxy ──────────────────────────────────────────────────────────
# Comma-separated IPs/CIDRs whose X-Forwarded-For header is believed. Empty
# (the default) trusts nobody and always uses the TCP peer address.
#
# Set this to your reverse proxy when you run one, or the audit log's source_ip
# and the session's ip will read as the proxy's address. Do NOT set it to a
# range that reaches clients: anything inside it can forge its own source IP and
# reset its own login rate limit by rotating the header.
# BPM_TRUSTED_PROXIES=10.0.0.0/8

# ─── feature flags & limits ─────────────────────────────────────────────────
# Read but currently without effect: the generic exec command is always refused.
BPM_ALLOW_EXEC=false

# true enables the read-only file browser (directory listings on every node).
BPM_FILEBROWSER=false

# Swarm service the sidebar "Restart Portainer" button force-updates. Runs on
# the leader's manager socket. Override if your agent service is named otherwise.
BPM_PORTAINER_SERVICE=portainer_agent

# Web Analytics (leader): containers whose image name starts with this prefix
# are read as Traefik JSON access logs. Daily totals are kept this many days.
# BPM_ANALYTICS_IMAGE_PREFIX=traefik
# BPM_ANALYTICS_RETENTION_DAYS=400

# Retention (leader). Log lines kept per container, optional age limit for log
# lines (0 = count only), 1-minute metric averages, raw heartbeat samples.
# BPM_LOG_MAX_LINES=5000
# BPM_LOG_RETENTION_HOURS=0
# BPM_METRIC_RETENTION_HOURS=24
# BPM_SAMPLE_RETENTION_HOURS=2

# ─── agent identity (override the hostname-derived default) ─────────────────
# BPM_AGENT_HOST_ID=node-a
# BPM_AGENT_LABELS=role=worker,zone=fsn1
# Default 5s; a slower cadence is easier on a dev machine.
BPM_HEARTBEAT_INTERVAL=30s
# Autodetected; override when the socket or host root is mounted elsewhere.
# BPM_DOCKER_SOCKET=/host/var/run/docker.sock
# BPM_HOST_PREFIX=/host

# ─── misc ───────────────────────────────────────────────────────────────────
BPM_LOG_LEVEL=info
# Parsed but currently unused (the UI is served same-origin).
# CORS_ORIGINS=http://localhost:3000
# BPM_S3_DEBUG=1 logs S3 requests and responses with bodies.
# The audit log mode (auto, on, off) is set on the Settings page.
