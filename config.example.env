# labextend — env reference. Copy to .env and edit for local dev.
# In production, prefer docker secrets over env vars for the BPM_* keys.

# ─── role selector ──────────────────────────────────────────────────────────
# Set LEADER=true on the leader node. Otherwise set LEADER_ADDR to point an
# agent at the leader's gRPC endpoint. Exactly one of the two must be set.
LEADER=true
# LEADER_ADDR=labextend-leader:9090

# ─── network ────────────────────────────────────────────────────────────────
HTTP_ADDR=:8080
GRPC_ADDR=:9090
EXTERNAL_URL=http://localhost:8080

# ─── storage ────────────────────────────────────────────────────────────────
DATA_DIR=/data

# ─── shared secret used by both leader and agents on the gRPC channel ───────
# Generate: openssl rand -hex 32
BPM_AGENT_TOKEN=

# ─── optional mTLS — set to enable cert-based auth on top of the token ──────
# BPM_GRPC_TLS_CERT=/run/secrets/grpc.crt
# BPM_GRPC_TLS_KEY=/run/secrets/grpc.key
# BPM_GRPC_TLS_CLIENT_CA=/run/secrets/ca.crt

# ─── leader-only at-rest encryption keys ────────────────────────────────────
# Each must be 32 bytes of hex (64 chars). Generate: openssl rand -hex 32
BPM_SECRETS_KEY=
BPM_TOTP_KEY=
BPM_TOTP_ISSUER=labextend

# ─── sessions ───────────────────────────────────────────────────────────────
SESSION_COOKIE_NAME=bpm_session
SESSION_TTL_HOURS=168
SESSION_SECURE_COOKIE=true

# ─── OIDC login (optional, e.g. Pocket ID) ──────────────────────────────────
# Enabled only when issuer, client id and client secret are all set. The
# redirect URL to register at the provider is EXTERNAL_URL + /api/auth/oidc/callback.
# BPM_OIDC_ISSUER=https://id.bartis.dev
# BPM_OIDC_CLIENT_ID=
# BPM_OIDC_CLIENT_SECRET=
# BPM_OIDC_CLIENT_SECRET_FILE=/run/secrets/labextend_oidc_client_secret
# BPM_OIDC_NAME=Pocket ID
#
# false hides the password form. Only honored while OIDC is enabled.
# BPM_PASSWORD_LOGIN=true

# ─── reverse proxy ──────────────────────────────────────────────────────────
# Comma-separated IPs/CIDRs whose X-Forwarded-For header is believed. Empty
# (the default) trusts nobody and always uses the TCP peer address.
#
# Set this to your reverse proxy when you run one, or the audit log's source_ip
# and the session's ip will read as the proxy's address. Do NOT set it to a
# range that reaches clients: anything inside it can forge its own source IP and
# reset its own login rate limit by rotating the header.
# BPM_TRUSTED_PROXIES=10.0.0.0/8

# ─── feature flags & limits ─────────────────────────────────────────────────
BPM_ALLOW_EXEC=false

# Swarm service the sidebar "Restart Portainer" button force-updates. Runs on
# the leader's manager socket. Override if your agent service is named otherwise.
BPM_PORTAINER_SERVICE=portainer_agent

# Web Analytics (leader): containers whose image name starts with this prefix
# are read as Traefik JSON access logs. Daily totals are kept this many days.
# BPM_ANALYTICS_IMAGE_PREFIX=traefik
# BPM_ANALYTICS_RETENTION_DAYS=400

# ─── agent identity (override the hostname-derived default) ─────────────────
# BPM_AGENT_HOST_ID=node-a
# BPM_AGENT_LABELS=role=worker,zone=fsn1
BPM_HEARTBEAT_INTERVAL=30s

# ─── misc ───────────────────────────────────────────────────────────────────
BPM_LOG_LEVEL=info
# CORS_ORIGINS=http://localhost:3000
# BPM_DISABLE_AUDIT=false
